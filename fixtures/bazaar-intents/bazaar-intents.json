{
  "schema": "hive.bazaar-intents.v1",
  "about": "HB-022 and HB-033 (S5 of the Launch-readiness & Trust upgrade, HB-035): 20 fixed Bazaar searches an agent shopping for what HivemindOS sells would run, each mapped to the HivemindOS resources it should find (listed), to none (unlisted), or out_of_scope with a dated note; plus one deliberately unlisted control URL for the unpaid Agents Trust sweep. Two copies, byte-identical, pinned by the same sha256: hivemind-cloud-services/workers/platform-api/bazaar/bazaar-intents.json in the HivemindOS monorepo (test/bazaar-intents.test.mjs) and fixtures/bazaar-intents/bazaar-intents.json in HivemindOS-Agents/bee-self-test (scripts/bazaar_weekly.py). Change both and both pins together.",
  "fixedAt": "2026-11-16",
  "hiveHosts": [
    "api.hivemindos.app",
    "hivemindos-paid-agent-gateway.hivemindos.workers.dev"
  ],
  "search": {
    "url": "https://api.cdp.coinbase.com/platform/v2/x402/discovery/search",
    "network": "eip155:8453",
    "limit": 20
  },
  "listed": {
    "url": "https://api.cdp.coinbase.com/platform/v2/x402/discovery/merchant",
    "payTo": [
      "0xbD62F8DCB52E21CA5BDf20ba173488Da101eBCf0"
    ],
    "note": "Bazaar's list of every active resource paid to HivemindOS's payTo, kept to hiveHosts. 57 URLs on 2026-11-16 (37 on api.hivemindos.app, 20 on the gateway). A urlSubstring search per host cross-checks for a HivemindOS URL listed under another payTo."
  },
  "inspect": {
    "url": "https://api.agents-trust.com/inspect",
    "view": "compact",
    "missesPerMinute": 20
  },
  "control": {
    "id": "control-unlisted",
    "url": "https://api.hivemindos.app/v1/x402/bazaar-control/never-listed",
    "expect": "unlisted",
    "note": "No such route exists or is listed. Bazaar must not list it and Agents Trust must answer 404 ENDPOINT_NOT_INDEXED; anything else means the sweep cannot tell indexed from not."
  },
